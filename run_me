#!/bin/bash

. $HOME/esp-idf/export.sh

aider \
    --model openai/qwen2.5-coder-14b \
    --openai-api-base http://alpaca:8080/v1 \
    --test-cmd "idf.py build" \
    --auto-test \
    --yes-always \
    --message "Implement main/display.c according to CURRENT_TASK.md. Ensure verification command passes." \
    main/display.c

# Automated checkbox check on build success
if [ $? -eq 0 ]; then
    sed -i 's/- \[ \] Task Complete/- [x] Task Complete/' CURRENT_TASK.md
fi
