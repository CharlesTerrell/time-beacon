CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_HELTEC_V1_1=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LWIP_SO_REUSE=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# Flash size (ESP32-S3FN8 has 8MB embedded flash)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Brownout Detector: Level 4 (~2.65V) to absorb brief transient RF current dips
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP_BROWNOUT_DET_LVL=4

# Bluetooth / NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Custom Partition Table with FATFS storage
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Wear Levelling and FATFS for USB MSC
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Wi-Fi & Static IP Configuration (Defaults if no config.ini exists)
CONFIG_NTP_WIFI_SSID="myssid"
CONFIG_NTP_WIFI_PASSWORD="mypassword"
CONFIG_NTP_USE_STATIC_IP=y
CONFIG_NTP_STATIC_IP="192.168.1.200"
CONFIG_NTP_STATIC_GW="192.168.1.1"
CONFIG_NTP_STATIC_NETMASK="255.255.255.0"
CONFIG_NTP_STATIC_DNS="1.1.1.1"
